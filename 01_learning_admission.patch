diff --git a/tests/test_household_admission.py b/tests/test_household_admission.py
new file mode 100644
--- /dev/null
+++ b/tests/test_household_admission.py
@@ -0,0 +1,129 @@
+from __future__ import annotations
+
+from datetime import datetime, timedelta, timezone
+
+from household_supply.domain import Item, Quantity
+from household_supply.household import (
+    ConsumptionObservation,
+    HouseholdEventId,
+    HouseholdHistory,
+    InventoryCorrection,
+    RecurringAdmissionStatus,
+    admit_recurring_estimate,
+    admitted_recurring_estimates,
+    depletion_learning_report,
+)
+
+
+UTC = timezone.utc
+BASE = datetime(2026, 9, 1, 8, 0, tzinfo=UTC)
+MILK = Item("milk", "Milk", "dairy")
+
+
+def use(event_id: str, amount: str, start: datetime, end: datetime):
+    return ConsumptionObservation(
+        HouseholdEventId(event_id),
+        MILK,
+        Quantity(amount, "ml"),
+        start,
+        end,
+        end,
+    )
+
+
+def count(event_id: str, amount: str, at: datetime):
+    return InventoryCorrection(
+        HouseholdEventId(event_id),
+        MILK,
+        Quantity(amount, "ml"),
+        at,
+        at,
+        "stocktake",
+    )
+
+
+def test_no_positive_rate_is_insufficient_for_recurring_demand() -> None:
+    history = HouseholdHistory(
+        (
+            count("d0", "1000", BASE),
+            count("d2", "1000", BASE + timedelta(days=2)),
+        )
+    )
+    report = depletion_learning_report(history, "milk")
+    assert report is not None
+    admission = admit_recurring_estimate(report)
+    assert admission.status is RecurringAdmissionStatus.INSUFFICIENT
+    assert admission.estimate is None
+    assert admission.accepted_estimate is None
+
+
+def test_one_long_sample_is_still_provisional() -> None:
+    history = HouseholdHistory(
+        (
+            use("u1", "600", BASE, BASE + timedelta(days=2)),
+        )
+    )
+    report = depletion_learning_report(history, "milk")
+    assert report is not None
+    assert report.estimate is not None
+    assert report.estimate.observed_days == 2
+    admission = admit_recurring_estimate(report)
+    assert admission.status is RecurringAdmissionStatus.PROVISIONAL
+    assert "requires_multiple_independent_samples" in admission.reasons
+    assert admission.accepted_estimate is None
+
+
+def test_two_independent_days_are_accepted() -> None:
+    history = HouseholdHistory(
+        (
+            use("u1", "300", BASE, BASE + timedelta(days=1)),
+            use(
+                "u2",
+                "500",
+                BASE + timedelta(days=1),
+                BASE + timedelta(days=2),
+            ),
+        )
+    )
+    report = depletion_learning_report(history, "milk")
+    assert report is not None
+    admission = admit_recurring_estimate(report)
+    assert admission.status is RecurringAdmissionStatus.ACCEPTED
+    assert admission.reasons == ()
+    assert admission.accepted_estimate == report.estimate
+
+
+def test_multiple_short_samples_remain_provisional() -> None:
+    first_end = BASE + timedelta(minutes=10)
+    second_start = BASE + timedelta(minutes=20)
+    second_end = BASE + timedelta(minutes=30)
+    history = HouseholdHistory(
+        (
+            use("u1", "1000", BASE, first_end),
+            use("u2", "1000", second_start, second_end),
+        )
+    )
+    report = depletion_learning_report(history, "milk")
+    assert report is not None
+    assert report.estimate is not None
+    admission = admit_recurring_estimate(report)
+    assert admission.status is RecurringAdmissionStatus.PROVISIONAL
+    assert "requires_at_least_two_observed_days" in admission.reasons
+    assert admission.accepted_estimate is None
+
+
+def test_bulk_admission_returns_only_accepted_estimates() -> None:
+    history = HouseholdHistory(
+        (
+            use("u1", "300", BASE, BASE + timedelta(days=1)),
+            use(
+                "u2",
+                "500",
+                BASE + timedelta(days=1),
+                BASE + timedelta(days=2),
+            ),
+        )
+    )
+    estimates = admitted_recurring_estimates(history)
+    assert len(estimates) == 1
+    assert estimates[0].item.id == "milk"
